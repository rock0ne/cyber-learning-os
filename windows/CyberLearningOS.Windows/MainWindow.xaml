<Window x:Class="CyberLearningOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Learning OS" Width="1280" Height="900" MinWidth="820" MinHeight="640"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#0A1524" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="About &amp; source" Click="Source_Click" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="CYBER LEARNING OS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="The complete 14-step learning guide"
                               FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1540" Margin="28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DebtText" Foreground="#FFC66D" FontWeight="SemiBold" FontSize="15" />
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,12,0,16">
                        <TextBlock x:Name="MissionText" TextWrapping="Wrap" FontSize="15" LineHeight="23" />
                    </Border>
                    <Button Content="+ Start a purposeful topic" Click="NewTopic_Click" Margin="0,0,0,8" />
                    <Button Content="View all 14 steps" Click="Roadmap_Click" Margin="0,0,0,14" />
                    <TextBlock Text="Learning topic" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="TopicSelector" SelectionChanged="TopicSelector_SelectionChanged" />
                    <TextBlock Text="Purpose" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,22,0,5" />
                    <TextBlock x:Name="PurposeText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                    <TextBlock Text="Desired capability" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,16,0,5" />
                    <TextBlock x:Name="CapabilityText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="EditorPanel" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="StepMetaText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="StepTitleText" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14" />

                        <UniformGrid x:Name="PageTabs" Columns="3" Margin="0,0,0,14">
                            <Button Content="Understand" Tag="Understand" Click="Page_Click" />
                            <Button Content="How to do it" Tag="Technique" Click="Page_Click" />
                            <Button Content="Practise &amp; prove" Tag="Practice" Click="Page_Click" />
                        </UniformGrid>

                        <StackPanel x:Name="UnderstandPanel">
                            <Border Background="#17283D" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="WHAT TO DO" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="WhatText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="22" /></StackPanel>
                            </Border>
                            <Border Background="#17283D" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="WHY IT MATTERS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="WhyText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="22" /></StackPanel>
                            </Border>
                            <Border Background="#17283D" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                <StackPanel><TextBlock x:Name="TechniqueNameText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="22" /></StackPanel>
                            </Border>
                            <Border Background="#2B2024" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="COMMON TRAP" Foreground="#FFB5A7" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="AvoidText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="22" /></StackPanel>
                            </Border>
                            <Border Background="#17283D" CornerRadius="9" Padding="14">
                                <StackPanel><TextBlock Text="TRANSCRIPT ANCHOR" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="SourceAnchorText" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="TechniquePanel" Visibility="Collapsed">
                            <Border Background="#17283D" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="HOW TO ACHIEVE IT" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="HowText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="23" /></StackPanel>
                            </Border>
                            <TextBlock x:Name="DiagramTitleText" Text="VISUAL MODEL" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,3,0,7" />
                            <StackPanel x:Name="DiagramPanel" Margin="0,0,0,10" />
                            <Border Background="#17283D" CornerRadius="9" Padding="14" Margin="0,0,0,10">
                                <StackPanel><TextBlock Text="CYBERSECURITY EXAMPLE" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="ExampleText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="22" /></StackPanel>
                            </Border>
                            <Border Background="#17283D" CornerRadius="9" Padding="14">
                                <StackPanel><TextBlock Text="TRY IT NOW" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="GuidedPracticeText" TextWrapping="Wrap" Margin="0,5,0,0" LineHeight="22" /></StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel x:Name="PracticePanel" Visibility="Collapsed">
                            <TextBlock Text="YOUR EVIDENCE" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock x:Name="EvidencePromptText" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" Margin="0,5,0,7" />
                            <TextBox x:Name="EvidenceField" MinHeight="150" />
                            <Border Background="#17283D" CornerRadius="9" Padding="14" Margin="0,12,0,0">
                                <StackPanel><TextBlock Text="YOU ARE READY TO CONTINUE WHEN" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="DoneText" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
                            </Border>
                            <StackPanel x:Name="EditorActions" Orientation="Horizontal" Margin="0,16,0,0">
                                <Button Content="Save evidence" Click="Save_Click" />
                                <Button x:Name="AdvanceButton" Content="Complete step" Click="Advance_Click" Background="#2B8E7A" />
                            </StackPanel>
                            <StackPanel x:Name="RatingPanel" Margin="0,14,0,0">
                                <TextBlock Text="After unaided retrieval, how well could you reconstruct and use it?" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,8" />
                                <WrapPanel>
                                    <Button Content="Again" Tag="Again" Click="Rate_Click" />
                                    <Button Content="Hard" Tag="Hard" Click="Rate_Click" />
                                    <Button Content="Good" Tag="Good" Click="Rate_Click" />
                                    <Button Content="Strong" Tag="Strong" Click="Rate_Click" />
                                </WrapPanel>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="#FFC66D" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
