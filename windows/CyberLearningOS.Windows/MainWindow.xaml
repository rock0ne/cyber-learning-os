<Window x:Class="CyberLearningOS.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyber Learning OS" Width="1180" Height="840" MinWidth="760" MinHeight="600"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource PrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="#0A1524" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="28,22">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="About &amp; source" Click="Source_Click" VerticalAlignment="Center" />
                <StackPanel>
                    <TextBlock Text="CYBER LEARNING OS" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" />
                    <TextBlock Text="Demonstrate understanding. Do not count consumption."
                               FontSize="27" FontWeight="SemiBold" Margin="0,5,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="1450" Margin="28,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="DebtText" Foreground="#FFC66D" FontWeight="SemiBold" FontSize="15" />
                    <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="18" Margin="0,12,0,16">
                        <TextBlock x:Name="MissionText" TextWrapping="Wrap" FontSize="15" LineHeight="23" />
                    </Border>
                    <Button Content="+ Start a purposeful topic" Click="NewTopic_Click" Margin="0,0,0,14" />
                    <TextBlock Text="Learning topic" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,5" />
                    <ComboBox x:Name="TopicSelector" SelectionChanged="TopicSelector_SelectionChanged" />
                    <TextBlock Text="Purpose" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,22,0,5" />
                    <TextBlock x:Name="PurposeText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                    <TextBlock Text="Desired capability" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,16,0,5" />
                    <TextBlock x:Name="CapabilityText" TextWrapping="Wrap" Foreground="{StaticResource SecondaryBrush}" />
                </StackPanel>

                <Border Grid.Column="2" x:Name="EditorPanel" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
                    <StackPanel>
                        <TextBlock x:Name="StageText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock x:Name="PromptText" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,5,0,14" />
                        <TextBlock x:Name="FieldOneLabel" Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,5" />
                        <TextBox x:Name="FieldOne" MinHeight="135" />
                        <TextBlock x:Name="FieldTwoLabel" Foreground="{StaticResource SecondaryBrush}" Margin="0,12,0,5" />
                        <TextBox x:Name="FieldTwo" MinHeight="110" />
                        <TextBlock x:Name="FieldThreeLabel" Foreground="{StaticResource SecondaryBrush}" Margin="0,12,0,5" />
                        <TextBox x:Name="FieldThree" MinHeight="110" />
                        <StackPanel x:Name="EditorActions" Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save evidence" Click="Save_Click" />
                            <Button Content="Save &amp; continue" Click="Advance_Click" Background="#2B8E7A" />
                        </StackPanel>
                        <StackPanel x:Name="RatingPanel" Margin="0,14,0,0">
                            <TextBlock Text="Retrieve first, then rate demonstrated performance." Foreground="{StaticResource SecondaryBrush}" Margin="0,0,0,8" />
                            <WrapPanel>
                                <Button Content="Again" Tag="Again" Click="Rate_Click" />
                                <Button Content="Hard" Tag="Hard" Click="Rate_Click" />
                                <Button Content="Good" Tag="Good" Click="Rate_Click" />
                                <Button Content="Strong" Tag="Strong" Click="Rate_Click" />
                            </WrapPanel>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Foreground="#FFC66D" Margin="0,14,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
