<Application x:Class="CyberLearningOS.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#07111F" />
        <SolidColorBrush x:Key="PanelBrush" Color="#101E30" />
        <SolidColorBrush x:Key="PanelAltBrush" Color="#17283D" />
        <SolidColorBrush x:Key="LineBrush" Color="#2D4664" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F2F7FF" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#AFC4DD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3DE5C2" />
        <Style TargetType="Button">
            <Setter Property="Background" Value="#243A52" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </Application.Resources>
</Application>
